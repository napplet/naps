{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAP conformance fixture file",
  "description": "Metadata and observation format for test fixtures; not a NAP wire schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "contract_revision",
    "cases"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "contract_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "layer",
        "requirements",
        "status",
        "preconditions",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "domain": {
          "type": "string",
          "enum": [
            "inc",
            "shell",
            "identity",
            "theme",
            "intent"
          ]
        },
        "layer": {
          "type": "string",
          "enum": [
            "binding",
            "runtime",
            "composition"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assertions"
          ],
          "properties": {
            "assertions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "wire": {
              "type": "object"
            },
            "reject_before_emission": {
              "const": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "properties": {
                  "assertions": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "expected": {
                "properties": {
                  "assertions": {
                    "maxItems": 0
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "wire"
                      ]
                    },
                    {
                      "required": [
                        "reject_before_emission"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
